# Copy to .env (next to docker-compose.yml) and adjust. Docker Compose reads .env automatically.

# Full URL the browser uses to reach the game hub through the reverse proxy.
# Empty = "<website origin>/hub".
SERVER_URL=https://game.example.com/server/hub

# Prefix the game server should accept when the proxy forwards its sub-path without
# stripping it (e.g. /server). Leave empty if the proxy strips the prefix.
PATH_BASE=

# Comma separated origins allowed to connect to the hub. Empty = allow any origin.
ALLOWED_ORIGINS=https://game.example.com

# Optional gameplay tuning, passed to the server as Game__<Setting> (see GameSettings.cs).
# Add these under the server's "environment:" in docker-compose.yml to use them.
# Game__ItemSpawnChance=0.1
# Game__CountdownSeconds=3
